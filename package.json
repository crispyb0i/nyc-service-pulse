{
  "name": "nyc-service-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "import:august": "node --env-file=.env.local --import tsx scripts/import.ts --mode=full",
    "import:refresh": "node --env-file=.env.local --import tsx scripts/import.ts --mode=refresh",
    "test:ui": "playwright test",
    "measure": "node --env-file=.env.local --import tsx scripts/measure.ts",
    "measure:map": "node --env-file=.env.local --import tsx scripts/measure-map.ts",
    "map:prepare": "node --env-file=.env.local scripts/prepare-map-geography.mjs",
    "measure:readiness": "node scripts/measure-readiness.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
